<%# One control with one current value, not four buttons in four colours. The
     status is a single choice from SDOHCC-ValueSetCapacityStatus, so a select
     says that; the colours said nothing except which button was pressed. %>
<%= form_with url: capacity_status_path, method: :post, class: "d-flex align-items-center gap-2" do |f| %>
  <%= f.label :capacity_status, "Capacity status", class: "text-muted small mb-0 text-nowrap" %>
  <%= f.select :capacity_status,
        options_for_select([["Capacity available", "capacity"],
                            ["At capacity", "at-capacity"],
                            ["Has waitlist", "has-waitlist"],
                            ["Additional assessment required", "assessment-required"]],
                           get_capacity_status),
        {},
        { class: "form-select form-select-sm", style: "width: auto;",
          onchange: "this.form.requestSubmit()" } %>
  <%= f.submit "Update", class: "btn btn-sm btn-outline-secondary" %>
<% end %>
