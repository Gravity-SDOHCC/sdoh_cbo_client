<div id="request-action-modal-<%= resource.id %>" class="modal" tabindex="-1" role="dialog"
     data-controller="task-action">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= resource.status.capitalize %> Task</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="card">
          <div class="card-header">
            <h6 class="card-title">ServiceRequest/<%= resource.focus&.id %></h6>
          </div>
          <div class="card-body">
            <!-- form with a GET method -->
            <%= form_with url: "/tasks/#{resource.id}/status", method: :get, id: "task-form-#{resource.id}", local: true do %>
              <div class="label-value">
                <span class="fw-semibold">Code:</span>
                <span class="small-text"><%= resource.focus&.description %></span>
              </div>
              <div class="label-value">
                <span class="fw-semibold">Category:</span>
                <span class="small-text"><%= resource.focus&.category%></span>
              </div>

              <div class="label-value">
                <span class="fw-semibold">Status:</span>
                <select name="task_status" class="form-select small-text" id="task_status-<%= resource.id %>"
                        data-task-action-target="statusSelect"
                        data-action="change->task-action#statusChanged">
                  <option value="">update the status</option>
                  <% statuses.each do |status| %>
                    <option value="<%= status %>"><%= status %></option>
                  <% end %>
                </select>
              </div>
              <div class="label-value status-reason-container" style="display:none;"
                   data-task-action-target="statusReasonContainer">
                <span class="fw-semibold">Status Reason:</span>
                <input type="text" name="status_reason" class="form-control small-text" id="status_reason-<%= resource.id %>">
              </div>

              <%# Program enrollment status, revealed only when the status being %>
              <%# set is completed. The CBO is the Referral Target in %>
              <%# enrollment.html, so this is where the enrollment outcome is %>
              <%# captured; leaving the status empty completes a referral that %>
              <%# had nothing to do with enrolling anyone. %>
              <% if statuses.include?("completed") %>
                <div class="enrollment-status-container" style="display:none;"
                     data-task-action-target="enrollmentContainer">
                  <div class="label-value">
                    <span class="fw-semibold">Program:</span>
                    <select name="enrollment_program" class="form-select small-text" id="enrollment_program-<%= resource.id %>">
                      <% enrollment_programs.each do |code, display| %>
                        <option value="<%= code %>"><%= display %></option>
                      <% end %>
                    </select>
                  </div>
                  <div class="label-value">
                    <span class="fw-semibold">Enrollment Status:</span>
                    <select name="enrollment_status" class="form-select small-text" id="enrollment_status-<%= resource.id %>">
                      <option value="">not an enrollment</option>
                      <% enrollment_statuses.each do |code, display| %>
                        <option value="<%= code %>"><%= display %></option>
                      <% end %>
                    </select>
                  </div>
                  <div class="label-value">
                    <span class="fw-semibold">Note:</span>
                    <input type="text" name="enrollment_note" class="form-control small-text" id="enrollment_note-<%= resource.id %>"
                           placeholder="e.g. the waitlist is currently about 2 months long">
                  </div>
                </div>

                <%# The findings this referral is being closed with. rffa.html: %>
                <%# when the loop is closed on a referral for further %>
                <%# assessment, "the information returned in Task.output %>
                <%# consists of the findings from that assessment". They go %>
                <%# back as Task.output:AdditionalContent entries alongside the %>
                <%# Procedure, which stays in PerformedActivityReference. %>
                <%# %>
                <%# Only resources already on the server can be attached here; %>
                <%# authoring assessment content in this client is a follow-on. %>
                <div class="assessment-findings-container" style="display:none;"
                     data-task-action-target="findingsContainer">
                  <% findings = assessment_findings(resource.patient_id, resource.focus&.sdoh_category_codes) %>
                  <div class="label-value">
                    <span class="fw-semibold">Assessment findings:</span>
                    <span class="small-text text-muted">
                      returned with the referral in Task.output
                    </span>
                  </div>
                  <% if findings&.any? %>
                    <div class="border rounded p-2" style="max-height: 14rem; overflow-y: auto;">
                      <% findings.groups.each do |group| %>
                        <div class="fw-semibold small-text text-muted mt-1"><%= group[:label] %></div>
                        <% group[:rows].each do |row| %>
                          <%= render "dashboard/finding_check_box", finding: row[:finding], task_id: resource.id %>
                          <%# The answers an instrument was scored from hang under %>
                          <%# it through Observation.derivedFrom, collapsed: the %>
                          <%# referral target returns the instrument, and the %>
                          <%# sixteen Observations behind it are there to be seen %>
                          <%# rather than ticked one by one. %>
                          <% if row[:answers].present? %>
                            <details class="ms-4">
                              <summary class="small-text text-muted">
                                <%= pluralize(row[:answers].size, "individual answer") %> recorded as Observations
                              </summary>
                              <% row[:answers].each do |answer| %>
                                <%= render "dashboard/finding_check_box", finding: answer, task_id: resource.id %>
                              <% end %>
                            </details>
                          <% end %>
                        <% end %>
                      <% end %>
                    </div>
                    <% if findings.truncated_types.present? %>
                      <span class="small-text text-muted">
                        Showing the <%= AssessmentFindings::PAGE_SIZE %> most recent
                        <%= findings.truncated_types.to_sentence %> records; older ones are not listed.
                      </span>
                    <% end %>
                  <% else %>
                    <span class="small-text text-muted">
                      No questionnaire responses, assessments, health concerns or goals are recorded
                      on this server for <%= resource.patient_name || "this patient" %>, so there is
                      nothing to return with the referral.
                    </span>
                  <% end %>
                </div>
              <% end %>

              <!-- submit button -->
              <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary">Submit</button>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
